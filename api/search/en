init-guide#dry-run","content":"full scan/coverage/maturity report"},"267":{"id":"/en/docs/init-guide-56","page_id":"/en/docs/init-guide","tags":[],"type":"text","url":"/en/docs/init-guide#dry-run","content":"planned create/reuse/skip actions"},"268":{"id":"/en/docs/init-guide-57","page_id":"/en/docs/init-guide","tags":[],"type":"text","url":"/en/docs/init-guide#dry-run","content":"no file system mutations"},"269":{"id":"/en/docs/memory-model","page_id":"/en/docs/memory-model","type":"page","content":"Memory Model Guide","breadcrumbs":["Docs","Workflows"],"tags":[],"url":"/en/docs/memory-model"},"270":{"id":"/en/docs/memory-model-0","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model","content":"Understand why RAGit separates working memory from searchable long-term memory"},"271":{"id":"/en/docs/memory-model-1","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#the-problem","content":"The Problem"},"272":{"id":"/en/docs/memory-model-2","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#the-mental-model","content":"The Mental Model"},"273":{"id":"/en/docs/memory-model-3","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#why-two-places-exist","content":"Why Two Places Exist"},"274":{"id":"/en/docs/memory-model-4","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#command-flow","content":"Command Flow"},"275":{"id":"/en/docs/memory-model-5","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#exact-path-sketch","content":"Exact path sketch"},"276":{"id":"/en/docs/memory-model-6","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#how-commands-map","content":"How Commands Map"},"277":{"id":"/en/docs/memory-model-7","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#a-simple-example","content":"A Simple Example"},"278":{"id":"/en/docs/memory-model-8","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#common-misunderstandings","content":"Common Misunderstandings"},"279":{"id":"/en/docs/memory-model-9","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#why-not-search-ragitmemory-directly","content":"Why not search `.ragit/memory/**` directly?"},"280":{"id":"/en/docs/memory-model-10","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#why-is-promote-separate-from-wrap","content":"Why is `promote` separate from `wrap`?"},"281":{"id":"/en/docs/memory-model-11","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#when-should-i-promote-something","content":"When should I promote something?"},"282":{"id":"/en/docs/memory-model-12","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#is-working-memory-the-same-as-a-snapshot","content":"Is working memory the same as a snapshot?"},"283":{"id":"/en/docs/memory-model-13","page_id":"/en/docs/memory-model","type":"heading","tags":[],"url":"/en/docs/memory-model#why-keep-both-working-memory-and-long-term-memory","content":"Why keep both working memory and long-term memory?"},"284":{"id":"/en/docs/memory-model-14","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model","content":"RAGit does not treat memory as one giant transcript. It separates memory by purpose so that an agent can resume work without dragging every raw note, tool output, or past conversation back into the prompt."},"285":{"id":"/en/docs/memory-model-15","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-problem","content":"Agents do not naturally remember your project the way a teammate does. A raw session log can tell you everything that happened, but it is bad at telling you what matters right now."},"286":{"id":"/en/docs/memory-model-16","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-problem","content":"For a user, the real question is simpler:"},"287":{"id":"/en/docs/memory-model-17","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-problem","content":"What was I trying to do?"},"288":{"id":"/en/docs/memory-model-18","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-problem","content":"Which constraints still matter?"},"289":{"id":"/en/docs/memory-model-19","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-problem","content":"What is still open?"},"290":{"id":"/en/docs/memory-model-20","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-problem","content":"What knowledge is now stable enough to reuse later?"},"291":{"id":"/en/docs/memory-model-21","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-problem","content":"RAGit splits memory so it can answer those questions directly instead of replaying the entire past."},"292":{"id":"/en/docs/memory-model-22","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"This diagram is the fastest mental model for the page. The top layer is temporary, the middle layer is active continuity, and the bottom layer is durable project knowledge. In the current MVP, RAGit puts most of its weight on the middle and bottom layers."},"293":{"id":"/en/docs/memory-model-23","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"Temporary scratch space for rough notes, partial observations, and in-session thinking. It exists conceptually, but it is not the main searchable layer in the MVP."},"294":{"id":"/en/docs/memory-model-24","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"The active state you want to resume: goal, constraints, open loops, and next actions. This layer restores momentum."},"295":{"id":"/en/docs/memory-model-25","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"Reusable project knowledge such as stable decisions, glossary entries, and durable plans. This layer restores durable knowledge."},"296":{"id":"/en/docs/memory-model-26","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"Think about memory in three layers:"},"297":{"id":"/en/docs/memory-model-27","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"**Short-term memory** is scratch space. It holds temporary notes, rough ideas, and in-progress observations inside a session."},"298":{"id":"/en/docs/memory-model-28","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"**Working memory** is the active state you want to resume tomorrow. It should tell you the goal, constraints, open loops, and next actions."},"299":{"id":"/en/docs/memory-model-29","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"**Long-term memory** is reusable project knowledge. It contains things that have become stable enough to search and reuse across future work."},"300":{"id":"/en/docs/memory-model-30","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#the-mental-model","content":"In the current MVP, RAGit emphasizes the second and third layers. Working memory helps you continue a task. Long-term memory helps you find durable knowledge again later. Short-term memory still exists conceptually, but it remains transient scratch space rather than a first-class searchable layer."},"301":{"id":"/en/docs/memory-model-31","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#why-two-places-exist","content":"RAGit uses two places because the project needs two different kinds of memory behavior."},"302":{"id":"/en/docs/memory-model-32","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#why-two-places-exist","content":"`.ragit/memory/**` is the **control plane**. It stores session wraps and current working state. This area is good for resuming work, but it is not meant to be your general searchable knowledge base."},"303":{"id":"/en/docs/memory-model-33","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#why-two-places-exist","content":"`docs/memory/**` is the **searchable corpus**. It stores promoted decisions, glossary entries, and plans as normal documents that can participate in ingest and snapshot-scoped retrieval."},"304":{"id":"/en/docs/memory-model-34","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#why-two-places-exist","content":"This split protects signal quality. Working memory stays focused on “what is active now,” while long-term memory stays focused on “what should remain findable later.”"},"305":{"id":"/en/docs/memory-model-35","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#command-flow","content":"The left lane is about continuity now. The right lane is about knowledge worth finding later. `memory recall` is the bridge between them: it starts from current working state and then pulls in relevant snapshot-scoped retrieval."},"306":{"id":"/en/docs/memory-model-36","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#command-flow","content":"`memory wrap` preserves continuity, `memory recall` restores the smallest useful packet, and `memory promote` crystallizes stable knowledge into searchable project memory."},"307":{"id":"/en/docs/memory-model-37","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#how-commands-map","content":"`memory wrap` records the state of the work you want to resume. It writes session history and refreshes the current working state."},"308":{"id":"/en/docs/memory-model-38","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#how-commands-map","content":"`memory recall` reconstructs the smallest useful packet for continuing work. It starts from what is active now in working memory and then supplements it with relevant snapshot-scoped retrieval results rather than replaying the full past."},"309":{"id":"/en/docs/memory-model-39","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#how-commands-map","content":"`memory promote` turns stable knowledge into searchable documents. It is how an important conclusion stops being a session detail and becomes project memory. In the current MVP, promoted documents are ingested immediately when `HEAD` is available."},"310":{"id":"/en/docs/memory-model-40","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#how-commands-map","content":"The key idea is that wrap is for continuity, recall is for restoration, and promote is for crystallization."},"311":{"id":"/en/docs/memory-model-41","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#a-simple-example","content":"Imagine you stop work on an auth migration at the end of the day."},"312":{"id":"/en/docs/memory-model-42","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#a-simple-example","content":"You use `memory wrap` to save the current goal, the rule that snapshot contracts must stay intact, the open loop about token refresh, and the next action for tomorrow. That state lives in `.ragit/memory/**`."},"313":{"id":"/en/docs/memory-model-43","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#a-simple-example","content":"The next morning, you do not want to reread every note. You use `memory recall`. RAGit pulls the current working state and combines it with relevant retrieved knowledge, such as earlier decisions about auth boundaries or plans stored in the repository. You get a recall packet that tells you where to restart."},"314":{"id":"/en/docs/memory-model-44","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#a-simple-example","content":"Later, once a rule becomes stable, such as “refresh token handling must remain outside snapshot mutation,” you use `memory promote`. That rule becomes a durable document in `docs/memory/**`, where future sessions can search it like any other project knowledge."},"315":{"id":"/en/docs/memory-model-45","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#why-not-search-ragitmemory-directly","content":"Because working state changes often and exists to help you resume active work. It is operational state, not automatically durable knowledge."},"316":{"id":"/en/docs/memory-model-46","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#why-is-promote-separate-from-wrap","content":"Because not every session note deserves to become long-term memory. Promotion is the deliberate step that keeps the searchable corpus clean."},"317":{"id":"/en/docs/memory-model-47","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#when-should-i-promote-something","content":"Promote it when you expect a future session to benefit from finding it without reopening the original session history. In the current MVP, that usually means a stable decision, a reusable term, or a plan worth searching later."},"318":{"id":"/en/docs/memory-model-48","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#is-working-memory-the-same-as-a-snapshot","content":"No. A snapshot answers, “What knowledge is searchable for this commit?” Working memory answers, “What am I actively trying to continue right now?”"},"319":{"id":"/en/docs/memory-model-49","page_id":"/en/docs/memory-model","tags":[],"type":"text","url":"/en/docs/memory-model#why-keep-both-working-memory-and-long-term-memory","content":"Because they solve different recovery problems. Working memory restores momentum. Long-term memory restores durable knowledge."},"320":{"id":"/en/docs/commands/describe","page_id":"/en/docs/commands/describe","type":"page","content":"describe","breadcrumbs":["Docs","Commands"],"tags":[],"url":"/en/docs/commands/describe"},"321":{"id":"/en/docs/commands/describe-0","page_id":"/en/docs/commands/describe","tags":[],"type":"text","url":"/en/docs/commands/describe","content":"Inspect machine-readable command contracts"},"322":{"id":"/en/docs/commands/describe-1","page_id":"/en/docs/commands/describe","type":"heading","tags":[],"url":"/en/docs/commands/describe#what-it-does","content":"What It Does"},"323":{"id":"/en/docs/commands/describe-2","page_id":"/en/docs/commands/describe","type":"heading","tags":[],"url":"/en/docs/commands/describe#when-to-use--when-not-to-use","content":"When To Use / When Not To Use"},"324":{"id":"/en/docs/commands/describe-3","page_id":"/en/docs/commands/describe","type":"heading","tags":[],"url":"/en/docs/commands/describe#when-to-use-it","content":"When to use it"},"325":{"id":"/en/docs/commands/describe-4","page_id":"/en/docs/commands/describe","type":"heading","tags":[],"url":"/en/docs/commands/describe#when-not-to-use-it","content":"When not to use it"},"326":{"id":"/en/docs/commands/describe-5","page_id":"/en/docs/commands/describe","type":"heading","tags":[],"url":"/en/docs/commands/describe#syntax","content":"Syntax"},"327":{"id":"/en/docs/commands/describe-6","page_id":"/en/docs/commands/describe","type":"heading","tags":[],"url":"/en/docs/co