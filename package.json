{
  "name": "ragit",
  "version": "2.0.0",
  "description": "RAG for git-based AI agent workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ragit": "dist/cli.js",
    "ragit-mcp": "dist/mcp.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "ragit": "tsx src/cli-entry.ts",
    "mcp": "tsx src/mcp-entry.ts",
    "build": "tsdown",
    "runtime:verify": "node scripts/verify-runtime-contract.mjs",
    "build:verify": "node scripts/verify-build-contract.mjs",
    "pack:verify": "node scripts/verify-pack-contract.mjs",
    "pack:smoke": "node scripts/smoke-packed-cli.mjs",
    "pack:upgrade-smoke": "node scripts/smoke-packed-upgrade.mjs",
    "benchmark:snapshot": "tsx scripts/benchmark-snapshot-selection.ts",
    "benchmark:retrieval": "tsx scripts/benchmark-retrieval.ts",
    "benchmark:retrieval:verify": "tsx scripts/benchmark-retrieval.ts --verify",
    "benchmark:retrieval:openai:verify": "tsx scripts/benchmark-retrieval.ts --verify --embedding-profile openai/text-embedding-3-small --thresholds benchmarks/retrieval/v1/thresholds-openai-text-embedding-3-small.json",
    "benchmark:retrieval:ollama:verify": "tsx scripts/benchmark-retrieval.ts --verify --embedding-profile ollama/nomic-embed-text --thresholds benchmarks/retrieval/v1/thresholds-ollama-nomic-embed-text.json",
    "release:check": "pnpm test && pnpm build && pnpm runtime:verify && pnpm build:verify && pnpm pack:verify && pnpm pack:smoke && pnpm pack:upgrade-smoke",
    "dev": "tsx src/cli-entry.ts",
    "test": "vitest run --pool=forks --no-isolate --maxWorkers=1 --no-file-parallelism --teardownTimeout=30000",
    "docs:dev": "pnpm --filter ./apps/docs... dev",
    "docs:build": "pnpm --filter ./apps/docs... build",
    "docs:check:commands": "pnpm --filter ./apps/docs... check:commands",
    "docs:check:internal-links": "pnpm --filter ./apps/docs... check:internal-links",
    "docs:check:i18n": "pnpm --filter ./apps/docs... check:i18n",
    "docs:check:search-index": "pnpm --filter ./apps/docs... check:search-index",
    "docs:serve": "pnpm --filter ./apps/docs... start"
  },
  "keywords": [
    "rag",
    "git",
    "cli",
    "agent"
  ],
  "author": "Rhio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhiokim/ragit.git"
  },
  "homepage": "https://rhiokim.github.io/ragit/en/",
  "bugs": {
    "url": "https://github.com/rhiokim/ragit/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@zvec/zvec": "0.2.1"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.10.1",
    "tsdown": "^0.21.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
